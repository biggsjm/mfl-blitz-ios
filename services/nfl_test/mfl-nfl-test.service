[Unit]
Description=MFL Blitz private historical NFL test
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/mfl-nfl-test/server.py --key-file %h/.config/mfl-nfl-test/api-key --state-dir %h/.local/share/mfl-nfl-test/state
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/mfl-nfl-test/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
